# Optional API credentials. The local demo works without these.
X_BEARER_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Storage. Unset = in-memory demo data (lost on restart).
# DATABASE_URL=postgres://user:pass@localhost:5432/feed
# SEED_DEMO=0   # skip seeding demo data into an empty database

# Sign in with X (OAuth 2.0 + PKCE). Create an app at developer.x.com with this callback URL.
# X_CLIENT_ID=
# X_CLIENT_SECRET=          # only for a confidential client
# X_REDIRECT_URI=http://127.0.0.1:3000/auth/x/callback
# Local development only: POST /auth/dev/login signs in as anyone. Never enable elsewhere.
# AUTH_DEV_LOGIN=1
