# Copy to connector.env, fill in, and load for both processes. Never commit the filled-in file.

# Public address (what claude.ai sees). Must match the Caddyfile host.
PUBLIC_URL=https://feeds.example.com
MCP_RESOURCE_URLS=https://feeds.example.com/mcp

# X developer app (OAuth 2.0, "Web App" type), callback https://feeds.example.com/auth/x/callback,
# scopes: tweet.read users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored X tokens; losing it means
# everyone signs in with X again. Rotating it disconnects everyone's X.
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=postgres://feed:CHANGE_ME@127.0.0.1:5432/feed
SEED_DEMO=0

# For the MCP connector process:
TRENDLIKER_URL=http://127.0.0.1:3000
TRENDLIKER_ISSUER=https://feeds.example.com
